SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-gmail-app-password

# Shared secret required in the X-Admin-Key header to call the admin-only
# shop endpoints (GET /shop/api/shops, PUT /shop/api/shop/{subdomain}/status).
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=your-long-random-admin-key

# Optional — only needed when running more than one worker/instance (see
# README "Rate limiting and workers"). Default keeps counters in memory.
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379

# Optional — set to true only on a developer machine to enable /docs,
# /redoc and /openapi.json. Keep unset in production.
# ENABLE_API_DOCS=true
