# ============================
# 📌 Python / FastAPI Backend
# ============================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*.so

# Virtual environment (venv*/ also catches names like venv-new/, venv2/)
venv/
venv*/
env/
ENV/
.venv/

# Environment variables
.env
.env.*
*.env
!.env.example

# Logs
*.log
logs/
uwsgi.log

# Cache
.cache/
.pytest_cache/
.mypy_cache/
pytest_cache/
__pypackages__/

# Build
build/
dist/
*.egg-info/

# SQLite / local DB
*.sqlite3
*.db

# Uploads / temp files
uploads/
media/
temp/
tmp/

# IDE folders
.vscode/
.idea/
*.iml

# OS files
.DS_Store
Thumbs.db

# ==================================================
# 📌 Node / React / Frontend (if you have frontend)
# ==================================================

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency folders
node_modules/

# Production build
build/
dist/
out/

# Temporary
*.tmp
*.temp

# Environment
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==================================================
# 📌 Docker
# ==================================================
docker/data/
docker/volumes/
docker-compose.override.yml

# ==================================================
# 📌 Tailwind
# ==================================================
# The standalone CLI binary the README's rebuild command downloads into the
# project root (never commit it — download fresh per platform instead).
/tailwindcss
/tailwindcss.exe
/tailwindcss-*

# ==================================================
# 📌 Misc
# ==================================================
*.swp
*.swo
*.bak
*.orig
*.old
*_copy.*
